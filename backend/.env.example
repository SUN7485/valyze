# Valyze backend: environment variables
# Copy to .env for local dev. In production set these in Vercel → Settings → Environment Variables.
# This file lists every variable the code reads. Keep it in sync when you add one.

# --- Required ---------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key   # bypasses RLS; server-side only
JWT_SECRET=change-me-to-a-long-random-string  # if unset in prod, derived from the Supabase key

# CORS: deployed frontend + client portal origins
FRONTEND_URL=
PORTAL_URL=
CORS_EXTRA_ORIGINS=          # comma-separated, optional (e.g. preview deploys)

# --- Optional ---------------------------------------------------------------
# Server-side Anthropic key for /api/proxy. When unset, each analyst's own key
# (sent by the browser) is used instead.
ANTHROPIC_API_KEY=

# Outbound mail (report delivery). Resend is used if its key is set, else SMTP.
MAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DELIVERY_SEND_ENABLED=false  # true = actually send delivery emails

# Upload limits
MAX_FILE_SIZE_MB=100
MAX_PORTAL_FILES_PER_ORDER=20
MAX_PORTAL_FILES_PER_COMPANY=5
UPLOAD_DIR=uploads           # local dev only; serverless disk is ephemeral

ENV=development              # "production" hides config details from /health
